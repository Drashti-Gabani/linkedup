<resources>
    <!-- Splash Screen Theme for Android 12+ (API 31+) -->
    <style name="SplashTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- For Android 11 and below compatibility -->
        <item name="android:windowBackground">@drawable/launch_screen</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        
        <!-- Android 12+ SplashScreen API - Hide default icon, use custom background -->
        <item name="android:windowSplashScreenBackground">@drawable/launch_screen</item>
        <!-- Use transparent icon to hide the default app icon -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/transparent_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <!-- Set animation duration to 0 to skip icon animation -->
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>

